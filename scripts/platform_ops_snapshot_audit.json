  "job_annotations": {
    "resolve-snapshot-tag": {
      "task": "确定统一快照 tag",
      "inputs": "deploy_env、snapshot_tag、snapshot_source_ref、repositories",
      "outputs": "snapshot_tag",
      "steps": {
        "Checkout repository": {
          "verify": "工作目录和控制脚本可用"
        },
        "Load GitHub App private key from Vault": {
          "verify": "运行时授权成功；不持久化或输出私钥"
        },
        "Create GitHub App installation token for infra": {
          "verify": "infra 组织访问权限"
        },
        "Create GitHub App installation token for lab": {
          "verify": "lab 组织访问权限"
        },
        "Create GitHub App installation token for services": {
          "verify": "services 组织访问权限"
        },
        "Create GitHub App installation token for xstream": {
          "verify": "xstream 组织访问权限"
        },
        "Resolve snapshot tag across all organizations": {
          "verify": "输出合法统一 tag；范围/环境不符时停止"
        }
      }
    },
    "snapshot": {
      "task": "按组织创建 tag、构建并记录状态",
      "inputs": "统一 tag、源码 ref、构建清单、组织矩阵",
      "outputs": "daily-snapshot-status-<organization>",
      "steps": {
        "Checkout repository": {
          "verify": "工作目录和控制脚本可用"
        },
        "Load GitHub App private key from Vault": {
          "verify": "运行时授权成功；不持久化或输出私钥"
        },
        "Create GitHub App installation token": {
          "verify": "当前组织权限"
        },
        "Create cross-repository main snapshot": {
          "verify": "tag、构建结果和制品状态可关联"
        },
        "Trigger XConnect multi-platform release": {
          "verify": "仅证明 repository_dispatch 已提交；未等待发布完成",
          "run_label": "gh api repository_dispatch（仅 xstream）"
        },
        "Upload snapshot status": {
          "verify": "组织状态 artifact；失败时也尝试上传"
        }
      }
    },
    "resolve-built-snapshot-tag": {
      "task": "确认完成的统一版本",
      "inputs": "各组织状态 artifact",
      "outputs": "完成的 snapshot_tag",
      "steps": {
        "Checkout repository": {
          "verify": "工作目录和控制脚本可用"
        },
        "Download all organization snapshot status artifacts": {
          "verify": "组织状态集合完整"
        },
        "Resolve immutable completed snapshot tag": {
          "verify": "解析完成的统一 tag；指定 repositories 时跳过"
        }
      }
    },
    "shared-readiness": {
      "task": "检查 Shared 服务",
      "inputs": "Vault/Grafana/IAM endpoint、issuer、超时",
      "outputs": "readiness 成功/失败",
      "steps": {
        "Checkout repository": {
          "verify": "工作目录和控制脚本可用"
        },
        "Check Shared platform readiness (read-only)": {
          "verify": "Vault initialized 且 unsealed；Grafana DB ok；IAM issuer 匹配",
          "playbooks": "B11 待新增 owner 接口；当前仍执行 Toolkit 探针"
        }
      }
    },
    "dispatch-environment": {
      "task": "读取 GitOps，派发并等待环境部署",
      "inputs": "完成的 tag、环境、GitOps topology",
      "outputs": "run_url、environment-dispatch-<environment>",
      "steps": {
        "Checkout repository": {
          "verify": "工作目录和控制脚本可用"
        },
        "Load GitHub App private key from Vault": {
          "verify": "运行时授权成功；不持久化或输出私钥"
        },
        "Create GitHub App installation token": {
          "verify": "读取 GitOps 和派发权限"
        },
        "Checkout selected GitOps topology": {
          "verify": "获得对应环境和模式的拓扑"
        },
        "Resolve target domain from GitOps": {
          "verify": "target_domain_base；环境和模式校验"
        },
        "Dispatch ${{ matrix.name }}": {
          "verify": "精确子运行 URL、终态、环境和 tag；按目标选择执行",
          "playbooks": "B01—B10 下游条件调用",
          "iac": "I01—I09 下游条件调用"
        },
        "Write dispatch receipt": {
          "verify": "环境、操作、workflow、tag、run_url、结果",
          "run_label": "jq 写脱敏派发回执"
        },
        "Upload dispatch receipt": {
          "verify": "环境回执 artifact"
        }
      }
    },
    "snapshot-summary": {
      "task": "汇总构建及环境派发",
      "inputs": "组织状态、环境派发回执",
      "outputs": "daily-snapshot-summary.json、environment-dispatch-summary.json、Actions Summary",
      "steps": {
        "Checkout repository": {
          "verify": "工作目录和控制脚本可用"
        },
        "Download all organization snapshot status artifacts": {
          "verify": "构建状态集合"
        },
        "Publish unified snapshot matrix summary": {
          "verify": "构建汇总 JSON 和 Actions Summary"
        },
        "Download environment dispatch receipts": {
          "verify": "部署未跳过时获得回执"
        },
        "Publish environment dispatch summary": {
          "verify": "环境派发汇总 JSON"
        },
        "Upload environment snapshot summary": {
          "verify": "daily-snapshot-summary-<environment> artifact"
        },
        "Fail when the selected environment dispatch failed": {
          "verify": "失败状态；当前外层 job 条件会阻止部分失败路径进入汇总",
          "run_label": "exit 1"
        }
      }
    }
  },
