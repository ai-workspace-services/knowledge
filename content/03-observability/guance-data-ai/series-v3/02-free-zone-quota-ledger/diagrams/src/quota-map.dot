digraph G { rankdir=LR; graph [bgcolor="white", fontname="Noto Sans CJK SC", pad=0.4, nodesep=0.45, ranksep=0.55];
node [shape=box, style="rounded,filled", fillcolor="#F5F7FA", color="#9AA5B1", fontname="Noto Sans CJK SC", fontsize=18, margin="0.25,0.14", penwidth=1.4];
edge [color="#52606D", fontname="Noto Sans CJK SC", fontsize=15, penwidth=1.4, arrowsize=0.8];

w [label="免费版工作空间\n免费专区（北京）\n1 个空间 · 最多 5 人", fillcolor="#FFFFFF"];
m [label="指标\n10,000 条时间线\n最多 10 台主机", fillcolor="#EAF2FF", color="#4C7BD9"];
l [label="日志类\n每天 1,000 万条", fillcolor="#EAF2FF", color="#4C7BD9"];
t [label="Trace（APM + Agent 共用）\n每天 20,000 个", fillcolor="#EAF2FF", color="#4C7BD9"];
r [label="RUM\nPV 每天 5,000 个\n会话重放每天 2,000 个", fillcolor="#EAF2FF", color="#4C7BD9"];
s [label="可用性监测\n每天 20 万次", fillcolor="#EAF2FF", color="#4C7BD9"];
k [label="存储\n7 天循环", fillcolor="#EEF8F0", color="#3E8E5A"];
o [label="超额：不再上报", fillcolor="#FFF4F4", color="#D64545", fontcolor="#9B2C2C"];
w -> m; w -> l; w -> t; w -> r; w -> s;
m -> k; l -> k; t -> k; r -> k; s -> k; k -> o [style=dashed, color="#D64545"];
}
