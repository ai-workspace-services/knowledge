digraph G { rankdir=LR; graph [bgcolor="white", fontname="Noto Sans CJK SC", pad=0.4, nodesep=0.45, ranksep=0.55];
node [shape=box, style="rounded,filled", fillcolor="#F5F7FA", color="#9AA5B1", fontname="Noto Sans CJK SC", fontsize=18, margin="0.25,0.14", penwidth=1.4];
edge [color="#52606D", fontname="Noto Sans CJK SC", fontsize=15, penwidth=1.4, arrowsize=0.8];

c [label="免费版功能边界", fillcolor="#FFFFFF"];
a1 [label="仪表板 / 笔记 / 查看器\n各 ≤ 10", fillcolor="#FFFBEA", color="#C99A06"];
a2 [label="监控器 ≤ 10\n仅阈值检测", fillcolor="#FFFBEA", color="#C99A06"];
a3 [label="Pipeline\n仅本地 Pipeline", fillcolor="#FFFBEA", color="#C99A06"];
n1 [label="不支持 Open API\n读写工作空间数据", fillcolor="#FFF4F4", color="#D64545", fontcolor="#9B2C2C"];
n2 [label="不支持\n数据转发 / 备份 · 外部数据源", fillcolor="#FFF4F4", color="#D64545", fontcolor="#9B2C2C"];
n3 [label="不支持\n敏感数据脱敏 / 扫描", fillcolor="#FFF4F4", color="#D64545", fontcolor="#9B2C2C"];
n4 [label="不支持\n快照 / 图表 / iframe 分享", fillcolor="#FFF4F4", color="#D64545", fontcolor="#9B2C2C"];
c -> a1; c -> a2; c -> a3; c -> n1; c -> n2; c -> n3; c -> n4;
}
