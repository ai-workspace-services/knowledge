digraph G { rankdir=TB; graph [bgcolor="white", fontname="Noto Sans CJK SC", pad=0.4, nodesep=0.45, ranksep=0.55];
node [shape=box, style="rounded,filled", fillcolor="#F5F7FA", color="#9AA5B1", fontname="Noto Sans CJK SC", fontsize=18, margin="0.25,0.14", penwidth=1.4];
edge [color="#52606D", fontname="Noto Sans CJK SC", fontsize=15, penwidth=1.4, arrowsize=0.8];

inv [label="盘点现有环境\n主机 · 时间线 · 仪表板 · 监控器 · PV", fillcolor="#FFFFFF"];
q [label="每项 ≤ 免费上限？", shape=diamond, style=filled, fillcolor="#FFFBEA", color="#C99A06", margin="0.05,0.05"];
y [label="整体接入 POC", fillcolor="#EEF8F0", color="#3E8E5A"];
n [label="瘦身：一条链路\n白名单采集 · 选定面板", fillcolor="#EAF2FF", color="#4C7BD9"];
u [label="采集侧统计发送量\n占比留余量", fillcolor="#FFFBEA", color="#C99A06"];
inv -> q; q -> y [label="是"]; q -> n [label="否"]; y -> u; n -> u;
}
