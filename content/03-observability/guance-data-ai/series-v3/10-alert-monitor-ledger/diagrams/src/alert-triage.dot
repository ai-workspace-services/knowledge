digraph G { rankdir=TB; graph [bgcolor="white", fontname="Noto Sans CJK SC", pad=0.4, nodesep=0.45, ranksep=0.55];
node [shape=box, style="rounded,filled", fillcolor="#F5F7FA", color="#9AA5B1", fontname="Noto Sans CJK SC", fontsize=18, margin="0.25,0.14", penwidth=1.4];
edge [color="#52606D", fontname="Noto Sans CJK SC", fontsize=15, penwidth=1.4, arrowsize=0.8];

r [label="自建告警规则", fillcolor="#FFFFFF"];
q [label="规则类型", shape=diamond, style=filled, fillcolor="#FFFBEA", color="#C99A06", margin="0.05,0.05"];
a [label="资源阈值\nCPU · 内存 · 磁盘", fillcolor="#EEF8F0", color="#3E8E5A"];
b [label="失联 / 无数据", fillcolor="#EAF2FF", color="#4C7BD9"];
c [label="站点与证书", fillcolor="#EAF2FF", color="#4C7BD9"];
d [label="采集管道自监控", fillcolor="#FFF4F4", color="#D64545", fontcolor="#9B2C2C"];
a2 [label="阈值检测监控器", fillcolor="#EEF8F0", color="#3E8E5A"];
b2 [label="阈值检测 + 数据断档事件", fillcolor="#EAF2FF", color="#4C7BD9"];
c2 [label="可用性监测\nHTTP / SSL 拨测", fillcolor="#EAF2FF", color="#4C7BD9"];
d2 [label="留在 Grafana", fillcolor="#FFF4F4", color="#D64545", fontcolor="#9B2C2C"];
r -> q; q -> a; q -> b; q -> c; q -> d; a -> a2; b -> b2; c -> c2; d -> d2;
}
