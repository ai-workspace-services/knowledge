digraph G { rankdir=TB; graph [bgcolor="white", fontname="Noto Sans CJK SC", pad=0.4, nodesep=0.45, ranksep=0.55];
node [shape=box, style="rounded,filled", fillcolor="#F5F7FA", color="#9AA5B1", fontname="Noto Sans CJK SC", fontsize=18, margin="0.25,0.14", penwidth=1.4];
edge [color="#52606D", fontname="Noto Sans CJK SC", fontsize=15, penwidth=1.4, arrowsize=0.8];

s [label="工作空间", fillcolor="#FFFFFF"];
q1 [label="版本支持 Open API？", shape=diamond, style=filled, fillcolor="#FFFBEA", color="#C99A06", margin="0.05,0.05"];
q2 [label="站点在 Open API\nendpoint 列表中？", shape=diamond, style=filled, fillcolor="#FFFBEA", color="#C99A06", margin="0.05,0.05"];
k [label="DF-API-KEY\n归属工作空间即作用域", fillcolor="#EAF2FF", color="#4C7BD9"];
tf [label="Terraform Provider\nplan / import / apply", fillcolor="#EEF8F0", color="#3E8E5A"];
off [label="HCL 照常生成并审查\napply 被阻断", fillcolor="#FFF4F4", color="#D64545", fontcolor="#9B2C2C"];
s -> q1; q1 -> q2 [label="是"]; q1 -> off [label="否（免费版）"]; q2 -> k [label="是"]; q2 -> off [label="否"]; k -> tf;
}
