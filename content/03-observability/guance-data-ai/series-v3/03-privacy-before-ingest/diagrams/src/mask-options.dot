digraph G { rankdir=TB; graph [bgcolor="white", fontname="Noto Sans CJK SC", pad=0.4, nodesep=0.45, ranksep=0.55];
node [shape=box, style="rounded,filled", fillcolor="#F5F7FA", color="#9AA5B1", fontname="Noto Sans CJK SC", fontsize=18, margin="0.25,0.14", penwidth=1.4];
edge [color="#52606D", fontname="Noto Sans CJK SC", fontsize=15, penwidth=1.4, arrowsize=0.8];

src [label="日志 · Trace 属性\n前端会话", fillcolor="#FFFFFF"];
o1 [label="方案 A：平台侧脱敏\n免费版不支持", style="rounded,filled,dashed", fillcolor="#FFF4F4", color="#D64545", fontcolor="#9B2C2C"];
o2 [label="方案 B：采集前过滤\nVector · Collector\nDataKit 本地 Pipeline", fillcolor="#EEF8F0", color="#3E8E5A"];
o3 [label="方案 C：不采集\n字段契约外一律丢弃", fillcolor="#EAF2FF", color="#4C7BD9"];
dst [label="观测云工作空间", fillcolor="#EAF2FF", color="#4C7BD9"];
src -> o1 [style=dashed, color="#D64545"]; src -> o2; src -> o3;
o2 -> dst; o3 -> dst;
}
