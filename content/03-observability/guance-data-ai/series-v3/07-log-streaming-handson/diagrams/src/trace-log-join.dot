digraph G { rankdir=LR; graph [bgcolor="white", fontname="Noto Sans CJK SC", pad=0.4, nodesep=0.45, ranksep=0.55];
node [shape=box, style="rounded,filled", fillcolor="#F5F7FA", color="#9AA5B1", fontname="Noto Sans CJK SC", fontsize=18, margin="0.25,0.14", penwidth=1.4];
edge [color="#52606D", fontname="Noto Sans CJK SC", fontsize=15, penwidth=1.4, arrowsize=0.8];

lg [label="日志\n含 trace_id 字段", fillcolor="#EAF2FF", color="#4C7BD9"];
tr [label="APM 链路\ntrace_id", fillcolor="#EAF2FF", color="#4C7BD9"];
j [label="按 trace_id 互相跳转", fillcolor="#EEF8F0", color="#3E8E5A"];
n [label="日志无 trace_id\n无法关联", style="rounded,filled,dashed", fillcolor="#FFF4F4", color="#D64545", fontcolor="#9B2C2C"];
lg -> j; tr -> j; n -> j [style=dashed, color="#D64545", arrowhead=none];
}
