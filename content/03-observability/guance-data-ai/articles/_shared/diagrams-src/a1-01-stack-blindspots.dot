digraph G { rankdir=TB; graph [bgcolor="white", fontname="Noto Sans CJK SC", fontsize=22, pad=0.4, nodesep=0.45, ranksep=0.55, labelloc=t];
node [shape=box, style="rounded,filled", fillcolor="#F5F7FA", color="#9AA5B1", fontname="Noto Sans CJK SC", fontsize=18, margin="0.25,0.14", penwidth=1.4];
edge [color="#52606D", fontname="Noto Sans CJK SC", fontsize=15, penwidth=1.4, arrowsize=0.8];
label="低成本栈能跑起来，但一次失败难解释";
user [label="用户浏览器\n（UAT 登录 / 内容读取）", fillcolor="#FFFFFF"];
subgraph cluster_run { label="业务链路（各自计费、各自条件）"; style="rounded,dashed"; color="#CBD2D9"; fontsize=16;
 cf [label="Cloudflare Pages / Workers\n入口与边缘逻辑", fillcolor="#EAF2FF", color="#4C7BD9"];
 cr [label="Cloud Run\n弹性后端", fillcolor="#EAF2FF", color="#4C7BD9"];
 sb [label="Supabase Free\nPostgres 数据库", fillcolor="#EAF2FF", color="#4C7BD9"];
}
graf [label="自建 Grafana / VictoriaMetrics\n基础指标（已有）", fillcolor="#EEF8F0", color="#3E8E5A"];
b1 [label="盲区：真实用户体验\n（页面错误、加载耗时）", shape=note, style="filled,dashed", fillcolor="#FFF4F4", color="#D64545", fontcolor="#9B2C2C"];
b2 [label="盲区：跨层请求上下文\n（边缘 → 后端 → 数据库）", shape=note, style="filled,dashed", fillcolor="#FFF4F4", color="#D64545", fontcolor="#9B2C2C"];
b3 [label="盲区：数据库查询级可视性\n（Free 不含 Log Drain / Metrics endpoint）", shape=note, style="filled,dashed", fillcolor="#FFF4F4", color="#D64545", fontcolor="#9B2C2C"];
res [label="结果：页面、API、数据库各有指标\n但一个人很难快速解释“这次用户为什么失败”", fillcolor="#FFFBEA", color="#C99A06"];
user -> cf -> cr -> sb;
cf -> graf [style=dotted, label="部分指标"]; cr -> graf [style=dotted];
user -> b1 [style=dashed, color="#D64545", arrowhead=none];
cr -> b2 [style=dashed, color="#D64545", arrowhead=none];
sb -> b3 [style=dashed, color="#D64545", arrowhead=none];
{b1 b2 b3 graf} -> res;
}
