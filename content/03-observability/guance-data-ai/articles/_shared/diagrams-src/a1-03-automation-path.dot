digraph G { rankdir=TB; graph [bgcolor="white", fontname="Noto Sans CJK SC", fontsize=22, pad=0.4, nodesep=0.45, ranksep=0.55, labelloc=t];
node [shape=box, style="rounded,filled", fillcolor="#F5F7FA", color="#9AA5B1", fontname="Noto Sans CJK SC", fontsize=18, margin="0.25,0.14", penwidth=1.4];
edge [color="#52606D", fontname="Noto Sans CJK SC", fontsize=15, penwidth=1.4, arrowsize=0.8];
label="AI 辅助的 IaC 路径：声明 → 审查 → 部署 → 验证";
ai [label="AI 助手\n起草声明与配置", shape=ellipse, fillcolor="#FFFFFF"];
g [label="GitOps\n非敏感环境参数\n监控意图", fillcolor="#EAF2FF", color="#4C7BD9"];
pr [label="PR 审查\n人工确认", fillcolor="#FFFBEA", color="#C99A06"];
tf [label="Terraform（IaC-modules）\nrenderer → HCL → plan", fillcolor="#EAF2FF", color="#4C7BD9"];
pb [label="Playbook\n部署采集配置", fillcolor="#EAF2FF", color="#4C7BD9"];
v [label="Vault\n运行时注入凭据\n管理 Key / 查询 Key / 写入 Token\n分开存放、分开授权", fillcolor="#EEF8F0", color="#3E8E5A"];
ok [label="验证\n首条数据、字段对照", fillcolor="#F5F7FA"];
free [label="普通免费空间：\n只展示离线生成的 HCL", shape=note, fillcolor="#FFF4F4", color="#D64545", fontcolor="#9B2C2C"];
coop [label="授权空间：\nplan → apply 远端资源", shape=note, fillcolor="#EAF2FF", color="#4C7BD9"];
ai -> g -> pr -> tf -> pb -> ok;
v -> pb [style=dashed, label="写入 Token"]; v -> tf [style=dashed, label="管理 Key（仅授权空间）"];
tf -> free [style=dotted, arrowhead=none]; tf -> coop [style=dotted, arrowhead=none];
}
