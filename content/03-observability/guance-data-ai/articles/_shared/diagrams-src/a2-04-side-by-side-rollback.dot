digraph G { rankdir=TB; graph [bgcolor="white", fontname="Noto Sans CJK SC", fontsize=22, pad=0.4, nodesep=0.45, ranksep=0.55, labelloc=t];
node [shape=box, style="rounded,filled", fillcolor="#F5F7FA", color="#9AA5B1", fontname="Noto Sans CJK SC", fontsize=18, margin="0.25,0.14", penwidth=1.4];
edge [color="#52606D", fontname="Noto Sans CJK SC", fontsize=15, penwidth=1.4, arrowsize=0.8];
label="并排对照与回退：新链路失败，不拖垮旧链路";
src [label="真实请求 / k6 压测", fillcolor="#FFFFFF"];
col [label="现有采集", fillcolor="#F5F7FA"];
subgraph cluster_old { label="原链路（保持不变）"; style=rounded; color="#3E8E5A";
 vm [label="VictoriaMetrics / VictoriaLogs\n原始存储", fillcolor="#EEF8F0", color="#3E8E5A"];
 gf [label="Grafana\n排障入口保留", fillcolor="#EEF8F0", color="#3E8E5A"];
 vm -> gf;
}
subgraph cluster_new { label="新增链路（开关控制）"; style="rounded,dashed"; color="#4C7BD9";
 dk [label="新增 SaaS 写入\n失败不阻断原采集", fillcolor="#EAF2FF", color="#4C7BD9"];
 gc [label="观测云面板", fillcolor="#EAF2FF", color="#4C7BD9"];
 dk -> gc;
}
cmp [label="同时间窗并排对照\n通过的面板才渐进切换", fillcolor="#FFFBEA", color="#C99A06"];
rb1 [label="配置回退：Git 版本\n→ 审查后的 plan / apply", shape=note, fillcolor="#FFFFFF", color="#52606D"];
rb2 [label="数据回退：依赖原始存储", shape=note, fillcolor="#FFFFFF", color="#52606D"];
src -> col; col -> vm; col -> dk [style=dashed];
gf -> cmp; gc -> cmp;
cmp -> rb1 [style=dotted, arrowhead=none]; vm -> rb2 [style=dotted, arrowhead=none];
}
