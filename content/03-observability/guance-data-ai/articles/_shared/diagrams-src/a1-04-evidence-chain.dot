digraph G { rankdir=TB; graph [bgcolor="white", fontname="Noto Sans CJK SC", fontsize=22, pad=0.4, nodesep=0.45, ranksep=0.55, labelloc=t];
node [shape=box, style="rounded,filled", fillcolor="#F5F7FA", color="#9AA5B1", fontname="Noto Sans CJK SC", fontsize=18, margin="0.25,0.14", penwidth=1.4];
edge [color="#52606D", fontname="Noto Sans CJK SC", fontsize=15, penwidth=1.4, arrowsize=0.8];
label="一条 UAT 请求的证据链：能关联的才算“链路”";
u [label="浏览器\nRUM 会话\n【待实测】", fillcolor="#FFFFFF", style="rounded,dashed"];
e [label="Cloudflare Workers\n边缘逻辑", shape=box, style="rounded,filled,dashed", fillcolor="#FFF4F4", color="#D64545", fontcolor="#9B2C2C"];
s [label="Cloud Run 服务\nTrace / 日志 / trace_id", fillcolor="#EAF2FF", color="#4C7BD9"];
d [label="Supabase Free\n数据库内部", style="rounded,filled,dashed", fillcolor="#FFF4F4", color="#D64545", fontcolor="#9B2C2C"];
span [label="应用侧 DB 调用 span\n（只看到调用耗时）", fillcolor="#EAF2FF", color="#4C7BD9"];
u -> e [label="请求"]; e -> s [label="trace context\n是否透传【待实测】"]; s -> span -> d [style=dashed];
legend [shape=plaintext, style="", label=<<TABLE BORDER="0" CELLSPACING="6"><TR><TD BGCOLOR="#EAF2FF" WIDTH="28"> </TD><TD ALIGN="LEFT">目标信号（以实测结果为准）</TD></TR><TR><TD BGCOLOR="#FFF4F4" WIDTH="28"> </TD><TD ALIGN="LEFT">未能关联前一律标为盲区</TD></TR><TR><TD BORDER="1" STYLE="dashed" WIDTH="28"> </TD><TD ALIGN="LEFT">待实测</TD></TR></TABLE>>];
}
