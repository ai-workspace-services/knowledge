digraph G { rankdir=TB; graph [bgcolor="white", fontname="Noto Sans CJK SC", fontsize=22, pad=0.4, nodesep=0.45, ranksep=0.55, labelloc=t];
node [shape=box, style="rounded,filled", fillcolor="#F5F7FA", color="#9AA5B1", fontname="Noto Sans CJK SC", fontsize=18, margin="0.25,0.14", penwidth=1.4];
edge [color="#52606D", fontname="Noto Sans CJK SC", fontsize=15, penwidth=1.4, arrowsize=0.8];
label="迁移漏斗：先盘点，再挑三个，再逐个定性";
inv [label="Grafana 导出 JSON 盘点\ndatasource · panel · 变量 · 查询\n单位 · 聚合窗口 · 阈值 · 告警", fillcolor="#F5F7FA", width=7];
pick [label="首批只选 3 个面板\n资源健康 ｜ API 流量与错误 ｜ k6 压测延迟", fillcolor="#EAF2FF", color="#4C7BD9", width=5.5];
ai [label="AI 输出映射清单 + 候选配置", fillcolor="#FFFFFF", width=4.5];
human [label="人工核对：字段 · 查询语义 · 分位数\n单位 · 缺数 · 变量 · 时间范围", fillcolor="#FFFBEA", color="#C99A06", width=4.5];
subgraph cluster_out { label=""; color="white";
 o1 [label="可迁移", fillcolor="#EEF8F0", color="#3E8E5A"];
 o2 [label="需重写", fillcolor="#FFFBEA", color="#C99A06"];
 o3 [label="暂保留在 Grafana", fillcolor="#FFF4F4", color="#D64545", fontcolor="#9B2C2C"];
}
inv -> pick -> ai -> human; human -> o1; human -> o2; human -> o3;
note [label="不承诺 JSON 直接兼容；历史数据留在原存储", shape=note, fillcolor="#FFFFFF"];
o2 -> note [style=invis];
}
