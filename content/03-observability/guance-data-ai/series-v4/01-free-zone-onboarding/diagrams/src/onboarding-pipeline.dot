digraph G { rankdir=TB; graph [bgcolor="white", fontname="Noto Sans CJK SC", pad=0.4, nodesep=0.45, ranksep=0.55];
node [shape=box, style="rounded,filled", fillcolor="#F5F7FA", color="#9AA5B1", fontname="Noto Sans CJK SC", fontsize=18, margin="0.25,0.14", penwidth=1.4];
edge [color="#52606D", fontname="Noto Sans CJK SC", fontsize=15, penwidth=1.4, arrowsize=0.8];

ai [label="AI 起草\n接入清单 · 声明 · 配置 · PR 说明", shape=ellipse, fillcolor="#FFFFFF"];
g [label="GitOps\n非敏感环境参数 · 监控意图", fillcolor="#EAF2FF", color="#4C7BD9"];
pr [label="PR 审查", fillcolor="#FFFBEA", color="#C99A06"];
r [label="iac_modules renderer\n显式 HCL", fillcolor="#EAF2FF", color="#4C7BD9"];
tf [label="terraform plan\n人审 plan", fillcolor="#FFFBEA", color="#C99A06"];
pb [label="Playbook\nDataKit · OTel Collector 配置", fillcolor="#EAF2FF", color="#4C7BD9"];
v [label="Vault\n运行时注入 · 凭据分开", fillcolor="#EEF8F0", color="#3E8E5A"];
q [label="空间支持 Open API？", shape=diamond, style=filled, fillcolor="#FFFBEA", color="#C99A06", margin="0.05,0.05"];
ap [label="apply 远端资源", fillcolor="#EEF8F0", color="#3E8E5A"];
blk [label="免费空间：apply 被阻断", style="rounded,filled,dashed", fillcolor="#FFF4F4", color="#D64545", fontcolor="#9B2C2C"];
ai -> g -> pr; pr -> r -> tf -> q; q -> ap [label="是"]; q -> blk [label="否"]; pr -> pb; v -> pb [style=dashed]; v -> tf [style=dashed];
}
