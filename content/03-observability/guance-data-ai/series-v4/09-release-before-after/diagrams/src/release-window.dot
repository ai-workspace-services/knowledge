digraph G { rankdir=LR; graph [bgcolor="white", fontname="Noto Sans CJK SC", pad=0.4, nodesep=0.45, ranksep=0.55];
node [shape=box, style="rounded,filled", fillcolor="#F5F7FA", color="#9AA5B1", fontname="Noto Sans CJK SC", fontsize=18, margin="0.25,0.14", penwidth=1.4];
edge [color="#52606D", fontname="Noto Sans CJK SC", fontsize=15, penwidth=1.4, arrowsize=0.8];

gh [label="GitHub Actions run", fillcolor="#FFFFFF"];
tag [label="release tag", fillcolor="#EAF2FF", color="#4C7BD9"];
rev [label="Cloud Run revision", fillcolor="#EAF2FF", color="#4C7BD9"];
ev [label="发布事件", fillcolor="#FFFBEA", color="#C99A06"];
cmp [label="同一时长窗口\n发布前 vs 发布后", fillcolor="#EEF8F0", color="#3E8E5A"];
gh -> tag -> rev -> ev -> cmp;
}
