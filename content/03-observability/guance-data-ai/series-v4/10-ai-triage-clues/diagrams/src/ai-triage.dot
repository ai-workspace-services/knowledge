digraph G { rankdir=TB; graph [bgcolor="white", fontname="Noto Sans CJK SC", pad=0.4, nodesep=0.45, ranksep=0.55];
node [shape=box, style="rounded,filled", fillcolor="#F5F7FA", color="#9AA5B1", fontname="Noto Sans CJK SC", fontsize=18, margin="0.25,0.14", penwidth=1.4];
edge [color="#52606D", fontname="Noto Sans CJK SC", fontsize=15, penwidth=1.4, arrowsize=0.8];

al [label="告警事件", fillcolor="#FFFFFF"];
ai [label="AI 助手\nObsy Copilot 或只读 MCP", fillcolor="#EAF2FF", color="#4C7BD9"];
q [label="只读查询\n指标 · 日志 · Trace", fillcolor="#EAF2FF", color="#4C7BD9"];
l [label="线索清单\n证据链接 · 假设", fillcolor="#FFFBEA", color="#C99A06"];
h [label="人决定处置", fillcolor="#EEF8F0", color="#3E8E5A"];
x [label="不自动修复", style="rounded,filled,dashed", fillcolor="#FFF4F4", color="#D64545", fontcolor="#9B2C2C"];
al -> ai -> q -> l -> h; ai -> x [style=dashed, arrowhead=none];
}
