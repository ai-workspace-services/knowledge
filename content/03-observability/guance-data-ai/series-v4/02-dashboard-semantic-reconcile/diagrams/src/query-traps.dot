digraph G { rankdir=TB; graph [bgcolor="white", fontname="Noto Sans CJK SC", pad=0.4, nodesep=0.45, ranksep=0.55];
node [shape=box, style="rounded,filled", fillcolor="#F5F7FA", color="#9AA5B1", fontname="Noto Sans CJK SC", fontsize=18, margin="0.25,0.14", penwidth=1.4];
edge [color="#52606D", fontname="Noto Sans CJK SC", fontsize=15, penwidth=1.4, arrowsize=0.8];

src [label="原查询\nPromQL（VictoriaMetrics）\nLogsQL（VictoriaLogs）", fillcolor="#EEF8F0", color="#3E8E5A"];
t1 [label="指标名 / 标签\n转换后是否一致", fillcolor="#FFFBEA", color="#C99A06"];
t2 [label="rate / increase\n窗口与 step", fillcolor="#FFFBEA", color="#C99A06"];
t3 [label="分位数\n计算方式", fillcolor="#FFFBEA", color="#C99A06"];
t4 [label="单位换算", fillcolor="#FFFBEA", color="#C99A06"];
t5 [label="缺数\n补零还是断线", fillcolor="#FFFBEA", color="#C99A06"];
t6 [label="变量与时间范围", fillcolor="#FFFBEA", color="#C99A06"];
dst [label="观测云图表\nPromQL 模式 / DQL", fillcolor="#EAF2FF", color="#4C7BD9"];
chk [label="同一时间窗并排比对", fillcolor="#F5F7FA"];
src -> t1 -> t2 -> t3 -> t4 -> t5 -> t6 -> dst -> chk;
}
