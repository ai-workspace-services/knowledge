digraph G { rankdir=TB; graph [bgcolor="white", fontname="Noto Sans CJK SC", pad=0.4, nodesep=0.45, ranksep=0.55];
node [shape=box, style="rounded,filled", fillcolor="#F5F7FA", color="#9AA5B1", fontname="Noto Sans CJK SC", fontsize=18, margin="0.25,0.14", penwidth=1.4];
edge [color="#52606D", fontname="Noto Sans CJK SC", fontsize=15, penwidth=1.4, arrowsize=0.8];

subgraph cluster_a { label="同一故障域"; style="rounded,dashed"; color="#D64545"; fontsize=16;
 app [label="UAT 服务", fillcolor="#EAF2FF", color="#4C7BD9"];
 mon [label="自建监控\nGrafana 告警", fillcolor="#EEF8F0", color="#3E8E5A"];
}
ext [label="外部拨测\n平台节点", fillcolor="#EAF2FF", color="#4C7BD9"];
f [label="受控 UAT 故障\n不碰生产", fillcolor="#FFFBEA", color="#C99A06"];
f -> app; f -> mon [style=dashed]; ext -> app; ext -> mon [label="探测监控入口"];
}
